---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contatti from '../components/Contatti.astro';
---

<BaseLayout
  title="Contatti — Mirko Passeri, Web Designer ad Anzio"
  description="Hai domande sul web o vuoi parlare di idee digitali? Scrivimi — rispondo sempre. Mirko Passeri, web designer con base ad Anzio."
  canonical="https://www.mirkopasseri.it/contatti/"
>
  <main class="min-h-screen">
    <div class="max-w-7xl mx-auto px-8 md:px-24 pt-16">
      <a
        href="/"
        class="inline-block text-xs font-semibold uppercase tracking-widest text-accent hover:underline focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
      >
        ← Torna alla home
      </a>
    </div>
    <section
      class="max-w-7xl mx-auto px-8 md:px-24 pt-16 md:pt-20 pb-4"
      aria-labelledby="titolo-pagina-contatti"
    >
      <h1
        id="titolo-pagina-contatti"
        class="font-title text-5xl md:text-7xl text-primary leading-tight"
      >
        Parliamo del tuo progetto web
      </h1>
      <p class="mt-6 max-w-3xl text-lg text-primary/80 leading-relaxed">
        Realizzo siti web e interfacce frontend con attenzione ad accessibilità, performance,
        responsive design e SEO tecnico. Valuto nuove collaborazioni e seguo progetti da Anzio e
        zone limitrofe, con realtà locali e da remoto in tutta Italia.
      </p>
    </section>
    <Contatti />
  </main>
</BaseLayout>
