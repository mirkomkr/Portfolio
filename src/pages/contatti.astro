---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contatti from '../components/Contatti.astro';
---

<BaseLayout
  title="Contatti — Mirko Passeri, Web Designer ad Anzio"
  description="Contatta Mirko Passeri per siti web, landing page, interfacce frontend e prime verifiche gratuite della homepage."
  canonical="https://www.mirkopasseri.it/contatti/"
>
  <main class="max-w-7xl mx-auto px-8 md:px-24 py-16 md:py-20">
    <section
      class="max-w-6xl"
      aria-labelledby="titolo-pagina-contatti"
    >
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-primary/70">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a
              href="/"
              class="font-semibold text-accent transition-colors hover:text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
            >
              Home
            </a>
          </li>
          <li aria-hidden="true" class="text-primary/40">/</li>
          <li aria-current="page" class="font-semibold text-primary">
            Contatti
          </li>
        </ol>
      </nav>
      <h1
        id="titolo-pagina-contatti"
        class="font-title text-5xl md:text-6xl xl:text-7xl text-primary leading-tight text-balance"
      >
        Parliamo del tuo progetto web
      </h1>
      <div class="mt-6 max-w-3xl space-y-4 text-lg text-primary/80 leading-relaxed">
        <p>
          Se vuoi realizzare o migliorare un sito, una landing o un’interfaccia frontend, puoi
          scrivermi da qui. Raccontami da dove parti, cosa ti serve e qual è il problema principale
          da risolvere.
        </p>
        <p>
          Puoi contattarmi anche per una prima verifica gratuita.
        </p>
      </div>
    </section>
    <Contatti />
  </main>
</BaseLayout>
