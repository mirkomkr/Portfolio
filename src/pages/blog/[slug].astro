---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const isDev = import.meta.env.DEV;
  // In produzione non genera la pagina per i post con draft: true
  const visiblePosts = isDev ? posts : posts.filter((p) => !p.data.draft);
  return visiblePosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonicalUrl = `https://www.mirkopasseri.it/blog/${post.id}/`;

// Articoli correlati: fetcha tutti, filtra per gli slug definiti in related[]
const allPosts = await getCollection('blog');
const relatedPosts = post.data.related
  ? allPosts.filter((p) => post.data.related!.includes(p.id))
  : [];

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  ...(post.data.dateModified && { "dateModified": post.data.dateModified.toISOString() }),
  "author": { "@id": "https://www.mirkopasseri.it/#persona" },
  "publisher": { "@id": "https://www.mirkopasseri.it/#persona" },
  "mainEntityOfPage": canonicalUrl,
  "inLanguage": "it",
  ...(post.data.image && { "image": `https://www.mirkopasseri.it${post.data.image.src}` }),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.mirkopasseri.it" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.mirkopasseri.it/blog/" },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": canonicalUrl }
  ]
};

// FAQPage schema — generato solo se il post ha FAQ nel frontmatter
// Questo è il segnale principale usato da ChatGPT, Gemini e Perplexity
// per citare il contenuto nelle risposte alle query degli utenti
const faqSchema = post.data.faq && post.data.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faq.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": a
    }
  }))
} : null;
---

<BaseLayout
  title={`${post.data.title} — Mirko Passeri`}
  description={post.data.description}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={post.data.image ? `https://www.mirkopasseri.it${post.data.image.src}` : undefined}
  ogImageAlt={post.data.imageAlt}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    )}
  </Fragment>

  <main>
    <div class="max-w-3xl mx-auto px-8 py-16 md:py-20">

      <header class="mb-12">
        <nav aria-label="Breadcrumb" class="mb-8 text-sm text-primary/70">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a
                href="/"
                class="font-semibold text-accent transition-colors hover:text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
              >
                Home
              </a>
            </li>
            <li aria-hidden="true" class="text-primary/40">/</li>
            <li>
              <a
                href="/blog/"
                class="font-semibold text-accent transition-colors hover:text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
              >
                Blog
              </a>
            </li>
            <li aria-hidden="true" class="text-primary/40">/</li>
            <li aria-current="page" class="min-w-0 font-semibold text-primary break-words">
              {post.data.title}
            </li>
          </ol>
        </nav>
        <!-- datetime nascosto per SEO schema, data non mostrata visivamente -->
        <time datetime={post.data.pubDate.toISOString().split('T')[0]} class="sr-only">
          Pubblicato il {post.data.pubDate.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <h1 class="font-title text-4xl md:text-5xl text-primary leading-tight mb-6 break-words text-balance">
          {post.data.title}
        </h1>
        <p class="text-lg text-primary/75 leading-relaxed border-l-4 border-accent pl-4">
          {post.data.description}
        </p>
      </header>

      {post.data.image && (
        <figure class="mb-12 -mx-8 md:mx-0">
          <Image
            src={post.data.image}
            alt={post.data.imageAlt ?? post.data.title}
            widths={[400, 800, 1200]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 800px"
            class="w-full h-auto rounded-lg"
            loading="eager"
            decoding="auto"
          />
        </figure>
      )}

      <article class="prose">
        <Content />
      </article>

      {post.data.faq && post.data.faq.length > 0 && (
        <section aria-labelledby="faq-articolo" class="mt-16 border-t border-primary/10 pt-10">
          <h2 id="faq-articolo" class="font-title text-3xl md:text-4xl text-primary mb-8">
            Domande frequenti
          </h2>
          <div class="divide-y divide-primary/10">
            {post.data.faq.map((faq) => (
              <details class="group py-5" name="faq-articolo">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 marker:hidden [&::-webkit-details-marker]:hidden">
                  <span class="font-semibold text-primary transition-colors duration-200 group-open:text-accent">
                    {faq.q}
                  </span>
                  <span aria-hidden="true" class="shrink-0 text-accent transition-transform duration-300 group-open:rotate-180">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 15.414l-6.293-6.293-1.414 1.414L12 18.243l7.707-7.708-1.414-1.414z"/>
                    </svg>
                  </span>
                </summary>
                <p class="mt-4 max-w-2xl text-base leading-relaxed text-primary/75">
                  {faq.a}
                </p>
              </details>
            ))}
          </div>
        </section>
      )}

      <footer class="mt-16 pt-8 border-t border-primary/10">

        {relatedPosts.length > 0 && (
          <nav aria-label="Articoli correlati" class="mb-10">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-6">Leggi anche</p>
            <ul class="space-y-4">
              {relatedPosts.map((related) => (
                <li>
                  <a
                    href={`/blog/${related.id}/`}
                    class="group block border border-primary/10 rounded-xl p-5 hover:border-accent/40 hover:bg-primary/[0.02] transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
                  >
                    <p class="font-semibold text-primary group-hover:text-accent transition-colors duration-300 mb-1">
                      {related.data.title}
                    </p>
                    <p class="text-sm text-primary/80 leading-relaxed">{related.data.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <p class="text-sm text-primary/75">
          Scritto da <strong class="text-primary">Mirko Passeri</strong> —
          <a href="/contatti/" class="text-accent hover:underline focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded">Scrivimi</a> se hai domande o vuoi parlarne.
        </p>
      </footer>

    </div>
  </main>
</BaseLayout>

<style>
  .prose { color: #333333; line-height: 1.8; }
  .prose :global(h2) {
    font-family: 'Playfair Display Variable', serif;
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    font-weight: 700;
    color: #333333;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.25;
  }
  .prose :global(h3) {
    font-family: 'Playfair Display Variable', serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: #333333;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }
  .prose :global(p) { margin-bottom: 1.3rem; font-size: 1.0625rem; }
  .prose :global(strong) { font-weight: 700; color: #333333; }
  .prose :global(em) { font-style: italic; opacity: 0.8; }
  .prose :global(a) { color: #4A6274; text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(a:hover) { opacity: 0.75; }
  .prose :global(hr) { border: none; border-top: 1px solid rgba(51,51,51,0.12); margin: 2.5rem 0; }
  .prose :global(ul) { list-style: none; padding-left: 0; margin-bottom: 1.3rem; }
  .prose :global(ul li) { position: relative; padding-left: 1.4rem; margin-bottom: 0.7rem; line-height: 1.75; }
  .prose :global(ul li::before) { content: '—'; position: absolute; left: 0; color: #4A6274; font-weight: 700; }
  .prose :global(blockquote) {
    border-left: 3px solid #4A6274;
    padding: 0.75rem 1.25rem;
    margin: 2rem 0;
    background: rgba(74,98,116,0.05);
    border-radius: 0 6px 6px 0;
    font-size: 0.95rem;
  }
</style>
