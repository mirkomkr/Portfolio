---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Articoli sul Web Design e la SEO — Mirko Passeri",
  "url": "https://www.mirkopasseri.it/blog/",
  "itemListElement": sortedPosts.map((post, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://www.mirkopasseri.it/blog/${post.id}/`,
    "name": post.data.title
  }))
};
---

<BaseLayout
  title="Blog — Guide sul Web di Mirko Passeri, Web Designer ad Anzio"
  description="Articoli su siti web, accessibilità e SEO scritti in modo chiaro — per titolari di attività e sviluppatori. Da Anzio, per chiunque."
  canonical="https://www.mirkopasseri.it/blog/"
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>
  </Fragment>
  <main class="max-w-7xl mx-auto px-8 md:px-24 py-16 md:py-20">

    <header class="mb-16 md:mb-20">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-primary/70">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a
              href="/"
              class="font-semibold text-accent transition-colors hover:text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
            >
              Home
            </a>
          </li>
          <li aria-hidden="true" class="text-primary/40">/</li>
          <li aria-current="page" class="font-semibold text-primary">
            Blog
          </li>
        </ol>
      </nav>
      <h1 class="font-title text-5xl md:text-7xl text-primary leading-tight">
        Blog
      </h1>
      <p class="mt-6 text-lg text-primary/75 max-w-2xl leading-relaxed">
        Note su web design, accessibilità e come costruire cose che funzionano davvero.
      </p>
    </header>

    {sortedPosts.length === 0 ? (
      <p class="text-primary/75">Nessun articolo ancora. Torna presto.</p>
    ) : (
      <ul class="space-y-8">
        {sortedPosts.map((post) => (
          <li class="group border-b border-primary/10 pb-8">
            <article>
              <h2 class="font-title text-2xl md:text-4xl text-primary mb-3 leading-tight break-words text-balance group-hover:text-accent transition-colors duration-300">
                <a
                  href={`/blog/${post.id}/`}
                  class="focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="text-primary/75 leading-relaxed max-w-2xl">{post.data.description}</p>
            </article>
          </li>
        ))}
      </ul>
    )}

  </main>
</BaseLayout>
