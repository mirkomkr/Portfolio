---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProgettiPreview from '../components/ProgettiPreview.astro';
import ChiSonoPreview from '../components/ChiSonoPreview.astro';
import CollaborazioniPreview from '../components/CollaborazioniPreview.astro';
import BlogPreview from '../components/BlogPreview.astro';
import FAQ from '../components/FAQ.astro';
import Contatti from '../components/Contatti.astro';
import { faqs } from '../data/faqs.js';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<BaseLayout
  title="Frontend Developer & Web Designer ad Anzio | Mirko Passeri"
  description="Siti web moderni, veloci e accessibili. Mirko Passeri, web designer ad Anzio disponibile per Nettuno, Pomezia, Aprilia, Latina e Roma."
  canonical="https://www.mirkopasseri.it"
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>

  <main>
    <section aria-label="Introduzione" class="hero">
      <Hero />
    </section>
    <section aria-label="Contenuti principali">
      <ChiSonoPreview />
      <ProgettiPreview />
      <CollaborazioniPreview />
      <BlogPreview />
      <FAQ />
      <Contatti />
    </section>
  </main>
</BaseLayout>
