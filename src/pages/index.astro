---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VerificaHomepage from '../components/VerificaHomepage.astro';
import ChiSonoPreview from '../components/ChiSonoPreview.astro';
import PercorsiCommercialiPreview from '../components/PercorsiCommercialiPreview.astro';
import ContattiPreview from '../components/ContattiPreview.astro';

const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.mirkopasseri.it/#website",
      "url": "https://www.mirkopasseri.it/",
      "name": "Mirko Passeri",
      "inLanguage": "it",
      "publisher": {
        "@id": "https://www.mirkopasseri.it/#persona"
      }
    },
    {
      "@type": "WebPage",
      "@id": "https://www.mirkopasseri.it/#webpage",
      "url": "https://www.mirkopasseri.it/",
      "name": "Realizzazione siti web ad Anzio e Nettuno | Mirko Passeri",
      "description": "Realizzo siti web ed e-commerce per attività e professionisti ad Anzio e Nettuno e seguo progetti da remoto in tutta Italia.",
      "inLanguage": "it",
      "isPartOf": {
        "@id": "https://www.mirkopasseri.it/#website"
      },
      "about": {
        "@id": "https://www.mirkopasseri.it/#persona"
      }
    }
  ]
};
---

<BaseLayout
  title="Realizzazione siti web ad Anzio e Nettuno | Mirko Passeri"
  description="Realizzo siti web ed e-commerce per attività e professionisti ad Anzio e Nettuno e seguo progetti da remoto in tutta Italia."
  canonical="https://www.mirkopasseri.it"
>
  <Fragment slot="schema">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(homepageSchema)}
    ></script>
  </Fragment>
  <main>
    <Hero />
    <PercorsiCommercialiPreview />
    <VerificaHomepage />
    <ChiSonoPreview />
    <ContattiPreview />
  </main>
</BaseLayout>
