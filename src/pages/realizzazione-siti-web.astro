---
import BaseLayout from '../layouts/BaseLayout.astro';

const interventi = [
  {
    title: 'Sito vetrina',
    text: 'Un sito chiaro per presentare attività, servizi, punti di forza e contatti.',
  },
  {
    title: 'Landing page',
    text: 'Una pagina focalizzata su un servizio, una campagna o una richiesta specifica.',
  },
  {
    title: 'Siti esistenti e restyling',
    text: 'Interventi su struttura, contenuti e interfaccia per migliorare un sito esistente, renderlo più chiaro e adattarlo meglio agli obiettivi dell’attività.',
  },
  {
    title: 'E-commerce',
    text: 'Un sito per presentare e vendere prodotti online, organizzato in base al catalogo, alle funzionalità necessarie e agli strumenti di gestione scelti.',
  },
];

const destinatari = [
  'Attività locali che vogliono presentare servizi e contatti con chiarezza',
  'Professionisti che devono spiegare competenze, servizi e modalità di lavoro',
  'Piccole imprese e attività commerciali che vogliono creare o migliorare il proprio sito',
];

const metodo = [
  'Definiamo obiettivi, pubblico e contenuti necessari.',
  'Organizzo struttura e percorso delle pagine.',
  'Sviluppo e verifico il sito sui dispositivi principali.',
  'Prepariamo insieme pubblicazione e passaggi successivi.',
];

const qualita = [
  {
    title: 'Mobile',
    text: 'Il sito viene progettato per essere chiaro e facile da usare anche sugli schermi più piccoli.',
  },
  {
    title: 'Performance',
    text: 'Mantengo pagine e risorse leggere, evitando complessità che non portano un beneficio reale.',
  },
  {
    title: 'Accessibilità',
    text: 'Struttura, navigazione e contenuti accessibili fanno parte naturale di un sito costruito bene.',
  },
  {
    title: 'SEO tecnico',
    text: 'Curo le basi tecniche e la struttura dei contenuti per aiutare le persone a trovarti più facilmente online.',
  },
];

const faqs = [
  {
    q: 'Quanto costa realizzare un sito web?',
    a: 'Dipende da obiettivi, numero di pagine, contenuti disponibili e complessità tecnica. Prima di parlare di costo è utile capire cosa deve fare il sito e quali materiali sono già pronti.',
  },
  {
    q: 'Quanto tempo serve per pubblicare un sito?',
    a: 'Dipende dallo scope e dalla disponibilità di testi, immagini e decisioni. Un sito semplice richiede meno tempo di un restyling o di un progetto con più sezioni e integrazioni.',
  },
  {
    q: 'Puoi migliorare un sito già esistente?',
    a: 'Sì. Posso intervenire con un restyling o con miglioramenti mirati su struttura, contenuti, interfaccia, mobile e performance, in base agli obiettivi del sito.',
  },
  {
    q: 'Fai manutenzione anche su siti realizzati da altri?',
    a: 'Sì, quando l’intervento è compatibile con il mio ambito tecnico. Prima di accettare il lavoro verifico codebase, strumenti e configurazione per capire se è fattibile e proporzionato allo scope; la possibilità di intervenire dipende quindi dalla tecnologia e dallo stato del progetto.',
  },
  {
    q: 'Offri assistenza continuativa?',
    a: 'Sì. Possiamo lavorare su un intervento singolo oppure valutare un’assistenza continuativa. Per esigenze ricorrenti si può definire una gestione mensile in base allo scope e al tipo di attività; modalità e costo dipendono dal progetto, senza un prezzo mensile fisso valido per ogni situazione.',
  },
  {
    q: 'Realizzi anche e-commerce?',
    a: 'Sì. Posso progettare e sviluppare siti e-commerce, lavorando su catalogo, pagine prodotto, categorie, percorso di acquisto e integrazioni necessarie. Complessità, piattaforma e modalità di gestione vengono valutate in base al progetto.',
  },
  {
    q: 'Possiamo lavorare anche se non siamo nella stessa città?',
    a: 'Sì. Posso seguire il progetto interamente da remoto, dalla definizione degli obiettivi alla revisione delle pagine e alla pubblicazione, usando call, email e strumenti condivisi.',
  },
  {
    q: 'Mi aiuti anche con testi, struttura e contenuti?',
    a: 'Sì. Posso aiutarti a organizzare le informazioni principali, chiarire le sezioni del sito e rendere i contenuti più comprensibili per chi visita la pagina.',
  },
];

const servicePageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://www.mirkopasseri.it/realizzazione-siti-web/#webpage',
      url: 'https://www.mirkopasseri.it/realizzazione-siti-web/',
      name: 'Realizzazione siti web ed e-commerce | Mirko Passeri',
      description:
        'Siti web ed e-commerce per attività e professionisti: nuovi progetti, restyling, manutenzione e assistenza ad Anzio, Nettuno e da remoto in tutta Italia.',
      inLanguage: 'it',
      isPartOf: {
        '@id': 'https://www.mirkopasseri.it/#website',
      },
      mainEntity: {
        '@id': 'https://www.mirkopasseri.it/realizzazione-siti-web/#service',
      },
    },
    {
      '@type': 'Service',
      '@id': 'https://www.mirkopasseri.it/realizzazione-siti-web/#service',
      url: 'https://www.mirkopasseri.it/realizzazione-siti-web/',
      name: 'Siti web ed e-commerce per attività e professionisti',
      serviceType: 'Realizzazione di siti web, e-commerce e restyling',
      provider: {
        '@id': 'https://www.mirkopasseri.it/#persona',
      },
      description:
        'Progettazione e realizzazione di siti web ed e-commerce per attività e professionisti, con interventi anche su struttura, contenuti e interfaccia di siti esistenti.',
      areaServed: [
        {
          '@type': 'City',
          name: 'Anzio',
        },
        {
          '@type': 'City',
          name: 'Nettuno',
        },
        {
          '@type': 'AdministrativeArea',
          name: 'Lazio',
        },
        {
          '@type': 'Country',
          name: 'Italia',
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Realizzazione siti web ed e-commerce | Mirko Passeri"
  description="Siti web ed e-commerce per attività e professionisti: nuovi progetti, restyling, manutenzione e assistenza ad Anzio, Nettuno e da remoto in tutta Italia."
  canonical="https://www.mirkopasseri.it/realizzazione-siti-web/"
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(servicePageSchema)} />
  </Fragment>
  <main class="max-w-7xl mx-auto px-5 sm:px-8 md:px-24 py-16 md:py-20 overflow-x-hidden">
    <header class="mb-16 md:mb-24">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-primary/70">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a
              href="/"
              class="font-semibold text-accent transition-colors hover:text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
            >
              Home
            </a>
          </li>
          <li aria-hidden="true" class="text-primary/40">/</li>
          <li aria-current="page" class="font-semibold text-primary">Siti web ed e-commerce</li>
        </ol>
      </nav>
      <h1
        class="font-title text-4xl sm:text-5xl md:text-7xl text-primary leading-tight text-balance"
      >
        Siti web ed <span class="whitespace-nowrap">e-commerce</span> per attività e professionisti
      </h1>
      <p class="mt-6 max-w-3xl text-lg text-primary/80 leading-relaxed text-pretty">
        Ogni progetto parte dai servizi, dai prodotti e dalle informazioni di cui hanno bisogno i
        tuoi clienti, per costruire un sito chiaro, semplice da usare e coerente con gli obiettivi
        dell’attività.
      </p>
      <a
        href="/contatti/"
        data-umami-event="service_contact_click"
        class="mt-10 inline-flex min-h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-md border border-accent bg-accent px-6 py-3 text-center text-sm font-semibold normal-case tracking-normal text-master transition-all hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
      >
        Parliamo del tuo sito
        <span aria-hidden="true">→</span>
      </a>
    </header>

    <section aria-labelledby="tipologie-intervento" class="mb-20 md:mb-28">
      <h2
        id="tipologie-intervento"
        class="font-title text-4xl md:text-5xl text-primary mb-10 text-balance"
      >
        Cosa posso realizzare
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          interventi.map((intervento) => (
            <li class="rounded-2xl border border-primary/20 p-6">
              <h3 class="font-title text-2xl text-primary mb-3 text-balance">{intervento.title}</h3>
              <p class="text-primary/75 leading-relaxed text-pretty">{intervento.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="manutenzione-siti-web" class="mb-20 md:mb-28">
      <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-accent">
        Supporto tecnico
      </p>
      <h2
        id="manutenzione-siti-web"
        class="font-title text-3xl sm:text-4xl text-primary mb-6 text-balance"
      >
        Manutenzione e assistenza per siti web
      </h2>
      <div class="max-w-4xl space-y-5 text-primary/80 leading-relaxed text-pretty">
        <p>
          Posso intervenire anche su siti già online, sia realizzati da me sia costruiti da altri,
          per correzioni, aggiornamenti e miglioramenti frontend. Se il sito è stato realizzato da
          altri, prima esamino codebase, strumenti e configurazione per capire se l’intervento è
          tecnicamente fattibile e proporzionato allo scope.
        </p>
        <p>
          Gli interventi possono riguardare, in base alla tecnologia e allo stato del progetto,
          correzione di bug, aggiornamenti dei contenuti, modifiche a layout e interfaccia, problemi
          responsive, performance, accessibilità e SEO tecnica. Su WordPress posso occuparmi anche
          di aggiornamenti e manutenzione di plugin, backup e controlli di routine quando compatibili
          con la piattaforma e l’hosting disponibili.
        </p>
        <p>
          Possiamo lavorare su un singolo intervento oppure valutare un’assistenza continuativa. Per
          esigenze ricorrenti si può definire una gestione mensile in base allo scope e al tipo di
          attività.
        </p>
        <p class="text-sm text-primary/70">
          Valuto interventi compatibili con il mio ambito frontend — HTML, CSS, JavaScript e progetti
          frontend basati su JavaScript — e, su WordPress, attività che non richiedano sviluppo PHP o
          backend personalizzato. Non seguo sviluppo backend custom o interventi che richiedono
          linguaggi fuori dal mio stack.
        </p>
      </div>
    </section>

    <section aria-labelledby="destinatari-siti-web" class="mb-20 md:mb-28">
      <h2
        id="destinatari-siti-web"
        class="font-title text-4xl md:text-5xl text-primary mb-10 text-balance"
      >
        Per chi è utile
      </h2>
      <ul class="space-y-5 max-w-3xl">
        {
          destinatari.map((destinatario) => (
            <li class="flex gap-4 text-primary/80 leading-relaxed">
              <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent" />
              <span>{destinatario}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 max-w-4xl md:max-w-none text-primary/80 leading-relaxed text-pretty">
        Con base ad Anzio, lavoro con attività e professionisti ad Anzio, Nettuno, Aprilia, Pomezia,
        Latina e Roma. Quando è utile per il progetto, posso incontrare il cliente presso la sua
        sede; seguo inoltre progetti da remoto in tutta Italia.
      </p>
      <p class="mt-5 max-w-4xl text-sm text-primary/75 leading-relaxed text-pretty">
        Se invece rappresenti un’agenzia, sei un designer o lavori in un piccolo team e cerchi
        supporto frontend su uno scope definito, trovi i dettagli nella pagina dedicata alle
        <a
          href="/collaborazioni/"
          class="font-semibold text-accent underline underline-offset-4 transition-opacity hover:opacity-75 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
        >
          collaborazioni frontend
        </a>.
      </p>
    </section>

    <section aria-labelledby="metodo-siti-web" class="mb-20 md:mb-28">
      <h2
        id="metodo-siti-web"
        class="font-title text-4xl md:text-5xl text-primary mb-10 text-balance"
      >
        Come lavoro
      </h2>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          metodo.map((passaggio, index) => (
            <li class="rounded-2xl border border-primary/20 p-6">
              <span class="text-xs font-semibold uppercase tracking-widest text-accent">
                Passaggio {index + 1}
              </span>
              <p class="mt-3 text-primary/80 leading-relaxed text-pretty">{passaggio}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="qualita-siti-web" class="mb-20 md:mb-28">
      <h2
        id="qualita-siti-web"
        class="font-title text-4xl md:text-5xl text-primary mb-10 text-balance"
      >
        Un sito costruito bene
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          qualita.map((elemento) => (
            <li class="rounded-2xl border border-primary/20 p-6">
              <h3 class="font-title text-2xl text-primary mb-3 text-balance">{elemento.title}</h3>
              <p class="text-primary/75 leading-relaxed text-pretty">{elemento.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mb-20 max-w-3xl md:mb-28">
      <p class="text-sm text-primary/75 leading-relaxed text-pretty">
        Un esempio concreto di questo approccio è
        <strong class="font-semibold text-primary">Azzurro di Mare</strong>, un caso studio demo in
        cui ho progettato un sito vetrina per un ristorante immaginario, lavorando su struttura,
        responsive design, performance, accessibilità e SEO tecnica.
      </p>
      <div class="mt-6 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href="/blog/caso-studio-sito-ristorante-azzurro-di-mare/"
          class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-md border border-accent/40 px-5 py-3 text-center text-sm font-semibold normal-case tracking-normal text-accent transition-all hover:bg-accent hover:text-master focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master sm:w-auto"
        >
          Leggi il caso studio
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/progetti/"
          class="text-sm font-semibold text-accent underline underline-offset-4 transition-opacity hover:opacity-75 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
        >
          Guarda gli altri progetti
        </a>
      </div>
    </div>

    <section
      aria-labelledby="verifica-tecnica-gratuita"
      class="mb-20 md:mb-28 border-y border-primary/10 py-10 md:py-12"
    >
      <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-accent">
        Per siti già online
      </p>
      <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
        <div class="max-w-3xl">
          <h2
            id="verifica-tecnica-gratuita"
            class="font-title text-3xl sm:text-4xl text-primary mb-5 text-balance"
          >
            Prima verifica gratuita del sito
          </h2>
          <p class="text-primary/80 leading-relaxed text-pretty">
            Hai già un sito online e vuoi capire da dove partire? Posso fare un controllo essenziale
            della homepage su velocità percepita, struttura della pagina, accessibilità
            automatizzata, chiarezza dei contenuti e percorso di contatto.
          </p>
          <p class="mt-4 text-primary/75 leading-relaxed text-pretty">
            Non è un audit completo, ma un primo controllo utile per capire se ci sono segnali da
            approfondire prima di parlare di restyling o interventi più ampi.
          </p>
        </div>
        <div class="flex flex-col items-start gap-8 md:min-w-64">
          <a
            href="/verifica-gratuita/"
            data-umami-event="audit_cta_click"
            class="inline-flex min-h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-md border border-accent bg-accent px-6 py-3 text-center text-sm font-semibold normal-case tracking-normal text-master transition-all hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
          >
            Scopri la verifica gratuita
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/blog/il-tuo-sito-funziona-davvero/"
            class="text-sm font-semibold text-accent underline underline-offset-4 transition-opacity hover:opacity-75 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
          >
            Prima vuoi fare qualche controllo da solo?<br />
            Leggi questo articolo
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="faq-siti-web" class="mb-20 md:mb-28">
      <h2 id="faq-siti-web" class="font-title text-4xl md:text-5xl text-primary mb-10 text-balance">
        Domande frequenti
      </h2>
      <div class="divide-y divide-primary/10">
        {
          faqs.map((faq) => (
            <details class="group py-6" name="faq-siti-web">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 marker:hidden [&::-webkit-details-marker]:hidden">
                <span class="font-semibold text-primary transition-colors duration-200 group-open:text-accent">
                  {faq.q}
                </span>
                <span
                  aria-hidden="true"
                  class="shrink-0 text-accent transition-transform duration-300 group-open:rotate-180"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 15.414l-6.293-6.293-1.414 1.414L12 18.243l7.707-7.708-1.414-1.414z" />
                  </svg>
                </span>
              </summary>
              <p class="mt-4 max-w-3xl pb-2 text-primary/75 leading-relaxed text-pretty">
                {faq.q === 'Quanto costa realizzare un sito web?' ? (
                  <>
                    {faq.a} Se vuoi capire meglio quali elementi incidono sul preventivo, puoi
                    leggere{' '}
                    <a
                      href="/blog/quanto-costa-un-sito-web/"
                      class="font-semibold text-accent underline underline-offset-4 transition-opacity hover:opacity-75 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
                    >
                      da cosa dipende il costo di un sito web
                    </a>{'.'}
                  </>
                ) : (
                  faq.a
                )}
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <section
      aria-labelledby="cta-siti-web"
      class="rounded-2xl border border-accent/30 bg-accent/10 p-6 sm:p-8 md:p-12"
    >
      <h2
        id="cta-siti-web"
        class="font-title text-3xl sm:text-4xl md:text-5xl text-primary mb-6 text-balance"
      >
        Hai un sito da realizzare o migliorare?
      </h2>
      <p class="max-w-2xl text-lg text-primary/75 leading-relaxed mb-10 text-pretty">
        Raccontami cosa deve fare il sito, a chi si rivolge, quali contenuti hai già e se il
        progetto può essere seguito interamente da remoto.
      </p>
      <a
        href="/contatti/"
        data-umami-event="service_contact_click"
        class="inline-flex min-h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-md border border-accent bg-accent px-6 py-3 text-center text-sm font-semibold normal-case tracking-normal text-master transition-all hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
      >
        Parliamo del tuo progetto
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</BaseLayout>
