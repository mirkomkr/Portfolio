---
import BaseLayout from '../layouts/BaseLayout.astro';

const interventi = [
  {
    title: 'Sito vetrina',
    text: 'Un sito chiaro per presentare attività, servizi, punti di forza e contatti.',
  },
  {
    title: 'Landing page',
    text: 'Una pagina focalizzata su un servizio, una campagna o una richiesta specifica.',
  },
  {
    title: 'Restyling',
    text: 'Un intervento su struttura, contenuti e interfaccia per rendere più efficace un sito esistente.',
  },
  {
    title: 'E-commerce',
    text: 'Una soluzione essenziale per vendere un catalogo contenuto senza complicare la gestione.',
  },
];

const destinatari = [
  'Attività locali che vogliono presentarsi online con chiarezza',
  'Professionisti che hanno bisogno di spiegare servizi e competenze',
  'Piccole imprese e attività commerciali che vogliono migliorare il proprio sito',
];

const metodo = [
  'Definiamo obiettivi, pubblico e contenuti necessari.',
  'Organizzo struttura e percorso delle pagine.',
  'Sviluppo e verifico il sito sui dispositivi principali.',
  'Prepariamo insieme pubblicazione e passaggi successivi.',
];

const qualita = [
  {
    title: 'Mobile',
    text: 'Il sito viene progettato per essere chiaro e facile da usare anche sugli schermi più piccoli.',
  },
  {
    title: 'Performance',
    text: 'Mantengo pagine e risorse leggere, evitando complessità che non portano un beneficio reale.',
  },
  {
    title: 'Accessibilità',
    text: 'Struttura, navigazione e contenuti accessibili fanno parte naturale di un sito costruito bene.',
  },
  {
    title: 'SEO tecnico',
    text: 'Curo le basi tecniche e la struttura dei contenuti per aiutare motori di ricerca e persone a comprendere il sito.',
  },
];

const faqs = [
  {
    q: 'Quanto costa realizzare un sito web?',
    a: 'Dipende da obiettivi, numero di pagine, contenuti disponibili e complessità tecnica. Prima di parlare di costo è utile capire cosa deve fare il sito e quali materiali sono già pronti.',
  },
  {
    q: 'Quanto tempo serve per pubblicare un sito?',
    a: 'Dipende dallo scope e dalla disponibilità di testi, immagini e decisioni. Un sito semplice richiede meno tempo di un restyling o di un progetto con più sezioni e integrazioni.',
  },
  {
    q: 'Puoi migliorare un sito già esistente?',
    a: 'Sì. Posso intervenire su struttura, contenuti, interfaccia, mobile, performance e aspetti tecnici che rendono il sito più chiaro e più semplice da usare.',
  },
  {
    q: 'Realizzi anche e-commerce?',
    a: 'Sì. Posso lavorare su pagine prodotto, categorie, sezioni promozionali, percorsi di acquisto e integrazioni frontend con strumenti esistenti. La complessità del progetto va valutata in base a catalogo, funzionalità, gestione ordini e strumenti già presenti.',
  },
  {
    q: 'Mi aiuti anche con testi, struttura e contenuti?',
    a: 'Sì. Posso aiutarti a organizzare le informazioni principali, chiarire le sezioni del sito e rendere i contenuti più comprensibili per chi visita la pagina.',
  },
];
---

<BaseLayout
  title="Realizzazione siti web per attività e professionisti | Mirko Passeri"
  description="Realizzazione di siti vetrina, landing page, restyling ed e-commerce per attività, professionisti e piccole imprese."
  canonical="https://www.mirkopasseri.it/realizzazione-siti-web/"
>
  <main class="max-w-7xl mx-auto px-5 sm:px-8 md:px-24 py-16 md:py-20 overflow-x-hidden">
    <header class="mb-16 md:mb-24">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-primary/70">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a
              href="/"
              class="font-semibold text-accent transition-colors hover:text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
            >
              Home
            </a>
          </li>
          <li aria-hidden="true" class="text-primary/40">/</li>
          <li aria-current="page" class="font-semibold text-primary">
            Siti web
          </li>
        </ol>
      </nav>
      <h1 class="font-title text-4xl sm:text-5xl md:text-7xl text-primary leading-tight text-balance">
        Siti web pensati per attività e professionisti
      </h1>
      <p class="mt-6 max-w-3xl text-lg text-primary/80 leading-relaxed">
        Realizzo siti web chiari e semplici da usare, costruiti intorno ai servizi che offri e alle
        informazioni di cui hanno bisogno i tuoi clienti.
      </p>
      <a
        href="/contatti/"
        class="mt-10 inline-flex min-h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-md border border-accent bg-accent px-6 py-3 text-center text-sm font-semibold normal-case tracking-normal text-master transition-all hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
      >
        Parliamo del tuo sito
        <span aria-hidden="true">→</span>
      </a>
    </header>

    <section aria-labelledby="tipologie-intervento" class="mb-20 md:mb-28">
      <h2 id="tipologie-intervento" class="font-title text-4xl md:text-5xl text-primary mb-10">
        Cosa posso realizzare
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          interventi.map((intervento) => (
            <li class="rounded-2xl border border-primary/20 p-6">
              <h3 class="font-title text-2xl text-primary mb-3">{intervento.title}</h3>
              <p class="text-primary/75 leading-relaxed">{intervento.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="destinatari-siti-web" class="mb-20 md:mb-28">
      <h2 id="destinatari-siti-web" class="font-title text-4xl md:text-5xl text-primary mb-10">
        Per chi è utile
      </h2>
      <ul class="space-y-5 max-w-3xl">
        {
          destinatari.map((destinatario) => (
            <li class="flex gap-4 text-primary/80 leading-relaxed">
              <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent" />
              <span>{destinatario}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 max-w-4xl md:max-w-none text-primary/80 leading-relaxed">
        Lavoro con attività e professionisti ad Anzio, Nettuno, Aprilia, Pomezia, Latina, Roma e da remoto in tutta Italia.
      </p>
    </section>

    <section aria-labelledby="metodo-siti-web" class="mb-20 md:mb-28">
      <h2 id="metodo-siti-web" class="font-title text-4xl md:text-5xl text-primary mb-10">
        Come lavoro
      </h2>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          metodo.map((passaggio, index) => (
            <li class="rounded-2xl border border-primary/20 p-6">
              <span class="text-xs font-semibold uppercase tracking-widest text-accent">
                Passaggio {index + 1}
              </span>
              <p class="mt-3 text-primary/80 leading-relaxed">{passaggio}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="qualita-siti-web" class="mb-20 md:mb-28">
      <h2 id="qualita-siti-web" class="font-title text-4xl md:text-5xl text-primary mb-10">
        Un sito costruito bene
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          qualita.map((elemento) => (
            <li class="rounded-2xl border border-primary/20 p-6">
              <h3 class="font-title text-2xl text-primary mb-3">{elemento.title}</h3>
              <p class="text-primary/75 leading-relaxed">{elemento.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      aria-labelledby="verifica-tecnica-gratuita"
      class="mb-20 md:mb-28 border-y border-primary/10 py-10 md:py-12"
    >
      <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-accent">
        Per siti già online
      </p>
      <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
        <div class="max-w-3xl">
          <h2 id="verifica-tecnica-gratuita" class="font-title text-3xl sm:text-4xl text-primary mb-5 text-balance">
            Prima verifica gratuita del sito
          </h2>
          <p class="text-primary/80 leading-relaxed">
            Hai già un sito online e vuoi capire da dove partire? Posso fare un controllo
            essenziale della homepage su velocità percepita, struttura della pagina, accessibilità
            automatizzata, chiarezza dei contenuti e percorso di contatto.
          </p>
          <p class="mt-4 text-primary/75 leading-relaxed">
            Non è un audit completo, ma un primo controllo utile per capire se ci sono segnali da
            approfondire prima di parlare di restyling o interventi più ampi.
          </p>
        </div>
        <div class="flex flex-col items-start gap-8 md:min-w-64">
          <a
            href="/verifica-gratuita/"
            class="inline-flex min-h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-md border border-accent bg-accent px-6 py-3 text-center text-sm font-semibold normal-case tracking-normal text-master transition-all hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
          >
            Scopri la verifica gratuita
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/blog/il-tuo-sito-funziona-davvero/"
            class="text-sm font-semibold text-accent underline underline-offset-4 transition-opacity hover:opacity-75 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
          >
            Prima vuoi fare qualche controllo da solo?<br />
            Leggi questo articolo
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="faq-siti-web" class="mb-20 md:mb-28">
      <h2 id="faq-siti-web" class="font-title text-4xl md:text-5xl text-primary mb-10">
        Domande frequenti
      </h2>
      <div class="divide-y divide-primary/10">
        {
          faqs.map((faq) => (
            <details class="group py-6" name="faq-siti-web">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 marker:hidden [&::-webkit-details-marker]:hidden">
                <span class="font-semibold text-primary transition-colors duration-200 group-open:text-accent">
                  {faq.q}
                </span>
                <span aria-hidden="true" class="shrink-0 text-accent transition-transform duration-300 group-open:rotate-180">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 15.414l-6.293-6.293-1.414 1.414L12 18.243l7.707-7.708-1.414-1.414z" />
                  </svg>
                </span>
              </summary>
              <p class="mt-4 max-w-3xl pb-2 text-primary/75 leading-relaxed">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section
      aria-labelledby="cta-siti-web"
      class="rounded-2xl border border-accent/30 bg-accent/10 p-6 sm:p-8 md:p-12"
    >
      <h2 id="cta-siti-web" class="font-title text-3xl sm:text-4xl md:text-5xl text-primary mb-6 text-balance">
        Hai un sito da realizzare o migliorare?
      </h2>
      <p class="max-w-2xl text-lg text-primary/75 leading-relaxed mb-10">
        Raccontami cosa deve fare, a chi si rivolge e quali contenuti hai già a disposizione.
      </p>
      <a
        href="/contatti/"
        class="inline-flex min-h-12 w-full sm:w-auto items-center justify-center gap-2 rounded-md border border-accent bg-accent px-6 py-3 text-center text-sm font-semibold normal-case tracking-normal text-master transition-all hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
      >
        Parliamo del tuo progetto
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</BaseLayout>
