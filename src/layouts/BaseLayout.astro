---
import '../styles/global.css';
import '@fontsource-variable/open-sans';
import '@fontsource-variable/playfair-display';
import { SEO } from 'astro-seo';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { contact } from '../data/contact.js';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  robots?: string;
}

const {
  title,
  description,
  canonical = 'https://www.mirkopasseri.it',
  ogImage = 'https://www.mirkopasseri.it/mirko-passeri-frontend-developer.webp',
  ogImageAlt = 'Mirko Passeri — Frontend Developer & Web Designer',
  ogType = 'website',
  robots = 'index, follow',
} = Astro.props;

const serviceArea = [
  { "@type": "City", "name": "Anzio" },
  { "@type": "City", "name": "Nettuno" },
  { "@type": "City", "name": "Aprilia" },
  { "@type": "City", "name": "Pomezia" },
  { "@type": "City", "name": "Latina" },
  { "@type": "City", "name": "Roma" },
  { "@type": "Country", "name": "Italia" }
];

const baseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.mirkopasseri.it/#persona",
      "name": "Mirko Passeri",
      "jobTitle": "Frontend Developer & Web Designer",
      "url": "https://www.mirkopasseri.it",
      "telephone": contact.phoneDisplay,
      "image": "https://www.mirkopasseri.it/mirko-passeri-frontend-developer.webp",
      "sameAs": [
        "https://www.linkedin.com/in/mirko-passeri/",
        "https://github.com/mirkomkr"
      ],
      "description": "Mirko Passeri è un Web Designer e Frontend Developer freelance specializzato nella realizzazione di siti web professionali, veloci e accessibili per le imprese e professionisti ad Anzio, Nettuno, Pomezia, Aprilia, Ardea, Latina e Roma. Crea siti web ottimizzati per i motori di ricerca (SEO) e le intelligenze artificiali (AEO).",
      "knowsAbout": ["Realizzazione siti web ad Anzio", "Sviluppo Web", "HTML", "CSS", "JavaScript", "React", "Vue", "Nuxtjs", "Nextjs", "Astro", "Accessibilità Web", "Local SEO", "Web Design"],
      "hasOccupation": {
        "@type": "Occupation",
        "name": "Frontend Developer",
        "occupationLocation": {
          "@type": "City",
          "name": "Anzio"
        },
        "description": "Realizzo di siti web e interfacce digitali con focus su accessibilità, performance e ottimizzazione per i motori di ricerca.",
        "skills": "HTML, CSS, JavaScript, React, Astro, Next.js, Accessibilità Web, SEO, Web Design, Realizzazione siti web"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.mirkopasseri.it/#website",
      "url": "https://www.mirkopasseri.it",
      "name": "Mirko Passeri — Realizzazione Siti Web ad Anzio",
      "description": "Cerchi qualcuno che realizzi il tuo sito web? Mirko Passeri è un frontend developer e web designer. Siti web veloci e moderni per aziende ad Anzio, Nettuno, Pomezia e Latina.",
      "author": { "@id": "https://www.mirkopasseri.it/#persona" },
      "publisher": { "@id": "https://www.mirkopasseri.it/#persona" },
      "inLanguage": "it"
    },
    {
      "@type": "Service",
      "@id": "https://www.mirkopasseri.it/#realizzazione-siti-web",
      "name": "Realizzazione siti web",
      "serviceType": "Realizzazione siti web",
      "provider": { "@id": "https://www.mirkopasseri.it/#persona" },
      "areaServed": serviceArea
    },
    {
      "@type": "Service",
      "@id": "https://www.mirkopasseri.it/#sviluppo-frontend",
      "name": "Sviluppo frontend",
      "serviceType": "Sviluppo frontend",
      "provider": { "@id": "https://www.mirkopasseri.it/#persona" },
      "areaServed": serviceArea
    },
    {
      "@type": "Service",
      "@id": "https://www.mirkopasseri.it/#performance-seo-accessibilita",
      "name": "Performance, SEO tecnico base e accessibilità",
      "serviceType": "Performance web, SEO tecnico base e accessibilità",
      "provider": { "@id": "https://www.mirkopasseri.it/#persona" },
      "areaServed": serviceArea
    }
  ]
};

---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Mirko Passeri" />
    <meta name="google-site-verification" content="JTVN5TjnWgrOKZasixKrMiB0Vut79SXjvAUbB67eu-Y" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: { title, type: ogType, image: ogImage },
        optional: { description, locale: 'it_IT', siteName: 'Mirko Passeri' },
        image: { alt: ogImageAlt, width: 1200, height: 630 },
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: ogImage,
        imageAlt: ogImageAlt,
      }}
    />
    <link rel="alternate" hreflang="it" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)}></script>
    <slot name="schema" />
  </head>
  <body class="bg-master text-primary antialiased scroll-smooth">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:top-4 focus:left-4 focus:px-5 focus:py-3 focus:bg-primary focus:text-master focus:rounded-md focus:font-semibold focus:text-sm focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
    >
      Vai al contenuto principale
    </a>
    <Header />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <Footer />

    <button
      id="torna-su"
      aria-label="Torna in cima alla pagina"
      aria-hidden="true"
      tabindex="-1"
      disabled
      class="fixed bottom-3 right-3 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-primary text-master shadow-md opacity-0 pointer-events-none transition-all duration-300 hover:bg-primary/80 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master md:bottom-8 md:right-8 md:h-11 md:w-11 md:shadow-lg"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 8.586l-6.293 6.293-1.414-1.414L12 5.757l7.707 7.708-1.414 1.414z"/>
      </svg>
    </button>

    <script is:inline>
      const btn = document.getElementById('torna-su');
      if (btn) {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        const getVisibilityThreshold = () => {
          const width = window.innerWidth;

          if (width < 640) {
            return 750;
          }

          if (width <= 1024) {
            return 550;
          }

          return 400;
        };

        const setBackToTopAvailability = (visible) => {
          btn.style.opacity = visible ? '1' : '0';
          btn.style.pointerEvents = visible ? 'auto' : 'none';
          btn.toggleAttribute('disabled', !visible);
          btn.setAttribute('aria-hidden', String(!visible));

          if (visible) {
            btn.removeAttribute('tabindex');
          } else {
            btn.setAttribute('tabindex', '-1');

            if (document.activeElement === btn) {
              btn.blur();
            }
          }
        };

        const updateBackToTopVisibility = () => {
          const visible = window.scrollY > getVisibilityThreshold();
          setBackToTopAvailability(visible);
        };

        window.addEventListener('scroll', updateBackToTopVisibility, { passive: true });
        window.addEventListener('resize', updateBackToTopVisibility);
        btn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
          });
        });
        updateBackToTopVisibility();
      }
    </script>
  </body>
</html>
