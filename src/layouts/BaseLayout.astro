---
import '../styles/global.css';
import '@fontsource-variable/open-sans';
import '@fontsource-variable/playfair-display';
import { SEO } from 'astro-seo';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  robots?: string;
}

const {
  title,
  description,
  canonical = 'https://www.mirkopasseri.it',
  ogImage = 'https://www.mirkopasseri.it/mirko-passeri-frontend-developer.webp',
  ogImageAlt = 'Mirko Passeri — Frontend Developer & Web Designer',
  ogType = 'website',
  robots = 'index, follow',
} = Astro.props;

const baseSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.mirkopasseri.it/#persona",
  "name": "Mirko Passeri",
  "url": "https://www.mirkopasseri.it/",
  "image": "https://www.mirkopasseri.it/mirko-passeri-frontend-developer.webp",
  "jobTitle": "Frontend developer e web designer freelance",
  "sameAs": [
    "https://www.linkedin.com/in/mirko-passeri/",
    "https://github.com/mirkomkr"
  ],
  "description": "Mirko Passeri è un web designer e frontend developer freelance. Progetta e sviluppa siti web e interfacce digitali con attenzione a chiarezza, accessibilità e performance.",
  "knowsAbout": [
    "Web design",
    "Sviluppo frontend",
    "Accessibilità web",
    "Performance web"
  ],
  "telephone": "+393751129348"
};

---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Mirko Passeri" />
    <meta name="google-site-verification" content="JTVN5TjnWgrOKZasixKrMiB0Vut79SXjvAUbB67eu-Y" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: { title, type: ogType, image: ogImage },
        optional: { description, locale: 'it_IT', siteName: 'Mirko Passeri' },
        image: { alt: ogImageAlt, width: 1200, height: 630 },
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: ogImage,
        imageAlt: ogImageAlt,
      }}
    />
    <link rel="alternate" hreflang="it" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)}></script>
    <slot name="schema" />
    <script is:inline>
      (() => {
        const consentKey = 'mirkopasseri.analytics-consent';
        const scriptSrc = 'https://cloud.umami.is/script.js';
        const websiteId = 'e7be4275-304e-410d-a21d-25ba99ed3ddf';
        const scriptSelector = `script[src="${scriptSrc}"][data-website-id="${websiteId}"]`;

        const readConsent = () => {
          try {
            return window.localStorage.getItem(consentKey);
          } catch {
            return null;
          }
        };

        const writeConsent = (value) => {
          try {
            window.localStorage.setItem(consentKey, value);
          } catch {
            // La scelta resta valida per la pagina corrente se lo storage non è disponibile.
          }
        };

        const loadUmami = () => {
          if (document.querySelector(scriptSelector)) return;

          const script = document.createElement('script');
          script.defer = true;
          script.src = scriptSrc;
          script.setAttribute('data-website-id', websiteId);
          document.head.appendChild(script);
        };

        if (readConsent() === 'granted') {
          loadUmami();
        }

        document.addEventListener('DOMContentLoaded', () => {
          const banner = document.getElementById('analytics-consent');
          const acceptButton = document.getElementById('analytics-consent-accept');
          const rejectButton = document.getElementById('analytics-consent-reject');
          const preferencesButton = document.getElementById('analytics-preferences');
          const heading = document.getElementById('analytics-consent-title');

          const openPreferences = () => {
            if (!banner) return;
            banner.hidden = false;
            heading?.focus();
          };

          const closePreferences = () => {
            if (banner) banner.hidden = true;
          };

          if (readConsent() === null) {
            openPreferences();
          }

          acceptButton?.addEventListener('click', () => {
            writeConsent('granted');
            loadUmami();
            closePreferences();
            preferencesButton?.focus();
          });

          rejectButton?.addEventListener('click', () => {
            const trackerWasLoaded = Boolean(document.querySelector(scriptSelector));
            writeConsent('denied');
            closePreferences();

            if (trackerWasLoaded) {
              window.location.reload();
              return;
            }

            preferencesButton?.focus();
          });

          preferencesButton?.addEventListener('click', openPreferences);
        });
      })();
    </script>
  </head>
  <body class="bg-master text-primary antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:top-4 focus:left-4 focus:px-5 focus:py-3 focus:bg-primary focus:text-master focus:rounded-md focus:font-semibold focus:text-sm focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
    >
      Vai al contenuto principale
    </a>
    <Header />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <Footer />

    <button
      id="torna-su"
      aria-label="Torna in cima alla pagina"
      aria-hidden="true"
      tabindex="-1"
      disabled
      class="fixed bottom-3 right-3 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-primary text-master shadow-md opacity-0 pointer-events-none transition-all duration-300 hover:bg-primary/80 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master md:bottom-8 md:right-8 md:h-11 md:w-11 md:shadow-lg"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 8.586l-6.293 6.293-1.414-1.414L12 5.757l7.707 7.708-1.414 1.414z"/>
      </svg>
    </button>

    <section
      id="analytics-consent"
      aria-labelledby="analytics-consent-title"
      class="fixed inset-x-4 bottom-4 z-[60] mx-auto max-w-3xl rounded-lg border border-primary/20 bg-master p-5 shadow-2xl md:bottom-8 md:p-6"
      hidden
    >
      <h2 id="analytics-consent-title" tabindex="-1" class="font-title text-2xl text-primary outline-none">
        Preferenze analytics
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-primary/80">
        Vorrei usare Umami Cloud per capire, in forma statistica, come viene utilizzato il sito e
        quali percorsi di contatto sono più utili. Umami viene caricato solo se accetti. Puoi
        cambiare scelta in qualsiasi momento dalla Cookie Policy.
      </p>
      <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button
          id="analytics-consent-reject"
          type="button"
          class="inline-flex min-h-11 items-center justify-center rounded-md border border-accent/40 px-5 py-2.5 text-sm font-semibold text-accent transition-colors hover:bg-accent hover:text-master focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
        >
          Continua senza analytics
        </button>
        <button
          id="analytics-consent-accept"
          type="button"
          class="inline-flex min-h-11 items-center justify-center rounded-md border border-accent bg-accent px-5 py-2.5 text-sm font-semibold text-master transition-colors hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
        >
          Accetta analytics
        </button>
      </div>
    </section>

    <script is:inline>
      const btn = document.getElementById('torna-su');
      if (btn) {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        const getVisibilityThreshold = () => {
          const width = window.innerWidth;

          if (width < 640) {
            return 750;
          }

          if (width <= 1024) {
            return 550;
          }

          return 400;
        };

        const setBackToTopAvailability = (visible) => {
          btn.style.opacity = visible ? '1' : '0';
          btn.style.pointerEvents = visible ? 'auto' : 'none';
          btn.toggleAttribute('disabled', !visible);
          btn.setAttribute('aria-hidden', String(!visible));

          if (visible) {
            btn.removeAttribute('tabindex');
          } else {
            btn.setAttribute('tabindex', '-1');

            if (document.activeElement === btn) {
              btn.blur();
            }
          }
        };

        const updateBackToTopVisibility = () => {
          const visible = window.scrollY > getVisibilityThreshold();
          setBackToTopAvailability(visible);
        };

        window.addEventListener('scroll', updateBackToTopVisibility, { passive: true });
        window.addEventListener('resize', updateBackToTopVisibility);
        btn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
          });
        });
        updateBackToTopVisibility();
      }
    </script>
  </body>
</html>
