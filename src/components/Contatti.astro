---
import { contact } from '../data/contact.js';

const KEY = import.meta.env.WEB3FORMS_ACCESS_KEY;
---

<section id="contatti" aria-labelledby="titolo-contatti" class="w-full py-12 md:py-16">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16 lg:items-start">
    <div>
      <h2 id="titolo-contatti" class="font-title text-3xl md:text-4xl text-primary">
        Scegli come contattarmi
      </h2>
      <p class="mt-4 text-base text-primary/75 leading-relaxed">
        Puoi scrivermi direttamente oppure usare il form. Rispondo appena possibile con un primo
        riscontro pratico.
      </p>

      <div class="mt-8 space-y-4">
        <div class="rounded-lg border border-primary/10 bg-primary/[0.03] p-5">
          <span class="text-xs font-semibold text-primary/70">Email</span>
          <p class="mt-3 text-sm text-primary/75 leading-relaxed">
            Per richieste, link del sito o dettagli del progetto.
          </p>
          <a
            href={contact.emailHref}
            class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-md border border-accent/40 px-5 py-2.5 text-center text-sm font-semibold text-accent transition-colors hover:bg-accent hover:text-master focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master sm:w-auto"
            aria-label="Scrivi a Mirko Passeri via email"
          >
            Scrivimi via email
            <span aria-hidden="true">&nbsp;→</span>
          </a>
          <span
            id="email-text"
            data-user={contact.emailUser}
            data-domain={contact.emailDomain}
            class="mt-3 block font-mono text-sm font-medium text-primary/80 break-all"
          >
            {contact.emailUser}[at]{contact.emailDomain}
          </span>
          <button
            id="copy-btn"
            type="button"
            class="mt-3 text-sm font-semibold text-accent transition-colors hover:text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
            aria-label="Copia l'indirizzo email"
            aria-live="polite"
          >
            Copia email
          </button>
        </div>

        <div class="rounded-lg border border-primary/10 bg-primary/[0.03] p-5">
          <span class="text-xs font-semibold text-primary/70">Telefono</span>
          <p class="mt-3 text-sm text-primary/75 leading-relaxed">
            Per capire velocemente se posso aiutarti.
          </p>
          <a
            href={contact.phoneHref}
            class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-md border border-accent/40 px-5 py-2.5 text-center text-sm font-semibold text-accent transition-colors hover:bg-accent hover:text-master focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master sm:w-auto"
            aria-label={`Chiama Mirko Passeri al numero ${contact.phoneDisplay}`}
          >
            Parliamone al telefono
            <span aria-hidden="true">&nbsp;→</span>
          </a>
          <span class="mt-3 block font-mono text-sm font-medium text-primary/80">
            {contact.phoneDisplay}
          </span>
        </div>

        <div class="rounded-lg border border-primary/10 bg-primary/[0.03] p-5">
          <span class="text-xs font-semibold text-primary/70">WhatsApp</span>
          <p class="mt-3 text-sm text-primary/75 leading-relaxed">
            Per messaggi rapidi o per inviarmi il link del sito.
          </p>
          <a
            href={contact.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-md border border-accent/40 px-5 py-2.5 text-center text-sm font-semibold text-accent transition-colors hover:bg-accent hover:text-master focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master sm:w-auto"
            aria-label={`Scrivi a Mirko Passeri su WhatsApp al numero ${contact.phoneDisplay}`}
          >
            Scrivimi su WhatsApp
            <span aria-hidden="true">&nbsp;→</span>
          </a>
        </div>
      </div>
    </div>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="rounded-lg border border-primary/10 bg-primary/[0.03] p-5 md:p-6"
    >
      <input type="hidden" name="access_key" value={KEY} />

      <div class="mb-4 rounded-lg border border-accent/20 bg-accent/10 p-4">
        <h3 class="font-title text-2xl text-primary">
          Per la verifica gratuita
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-primary/80">
          Nel messaggio inserisci il link del sito e, se vuoi, anche cosa non ti convince della
          homepage attuale.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-primary/75">
          <li>link del sito;</li>
          <li>dubbio principale;</li>
          <li>eventuale obiettivo della pagina.</li>
        </ul>
      </div>

      <div class="mb-6 rounded-lg border border-accent/20 bg-accent/10 p-4">
        <h3 class="font-title text-2xl text-primary">
          Per collaborazioni frontend
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-primary/80">
          Se mi scrivi da agenzia, designer o piccolo team, indicami cosa è già pronto e quale
          parte frontend vorresti sviluppare o migliorare.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-primary/75">
          <li>layout o mockup disponibili;</li>
          <li>pagina o sezione da sviluppare;</li>
          <li>eventuali vincoli tecnici o scadenze.</li>
        </ul>
      </div>

      <div class="space-y-5">
        <div>
          <label for="name" class="block text-sm font-semibold text-primary">
            Nome
          </label>
          <input
            required
            type="text"
            id="name"
            name="name"
            class="mt-2 w-full rounded-md border border-primary/25 bg-master px-4 py-3 text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:border-accent"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-primary">
            Email
          </label>
          <input
            required
            type="email"
            id="email"
            name="email"
            aria-describedby="email-error"
            class="mt-2 w-full rounded-md border border-primary/25 bg-master px-4 py-3 text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:border-accent"
          />
          <span id="email-error" class="sr-only">
            Inserisci un indirizzo email valido, per esempio nome@dominio.com
          </span>
        </div>

        <div>
          <label for="message" class="block text-sm font-semibold text-primary">
            Messaggio
          </label>
          <p id="message-help" class="mt-2 text-sm text-primary/70">
            Se richiedi la verifica gratuita, incolla qui il link del sito.
          </p>
          <textarea
            required
            id="message"
            name="message"
            aria-describedby="message-help"
            class="mt-2 min-h-36 w-full rounded-md border border-primary/25 bg-master px-4 py-3 text-primary focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:border-accent"
          ></textarea>
        </div>

        <div class="flex items-start gap-3">
          <input
            required
            type="checkbox"
            id="privacy-consent"
            name="privacy-consent"
            class="mt-1 h-4 w-4 cursor-pointer rounded border-primary/30 bg-master text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
          />
          <label for="privacy-consent" class="text-sm leading-relaxed text-primary/80">
            Dichiaro di aver letto e accettato la
            <a
              href="/privacy-policy/"
              class="font-semibold text-accent hover:underline focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
              target="_blank"
              rel="noopener noreferrer"
            >
              Privacy Policy
            </a>
            per il trattamento dei dati personali.*
          </label>
        </div>

        <button
          type="submit"
          class="inline-flex min-h-12 w-full items-center justify-center rounded-md border border-accent bg-accent px-6 py-3 text-sm font-semibold text-master transition-colors hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master sm:w-auto"
        >
          Invia messaggio
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-btn');
  const emailText = document.getElementById('email-text');

  if (emailText) {
    const user = emailText.getAttribute('data-user');
    const domain = emailText.getAttribute('data-domain');
    const email = `${user}@${domain}`;
    emailText.innerText = email;
  }

  copyBtn?.addEventListener('click', () => {
    if (emailText) {
      navigator.clipboard.writeText(emailText.innerText);

      const originalText = copyBtn.innerText;
      copyBtn.innerText = 'Copiato!';

      setTimeout(() => {
        copyBtn.innerText = originalText;
      }, 2000);
    }
  });
</script>
