---
import { contact } from '../data/contact.js';

const KEY = import.meta.env.WEB3FORMS_ACCESS_KEY;
---

<section id="contatti" aria-labelledby="titolo-contatti" class="flex flex-col justify-center items-center md:items-end w-full min-h-screen max-w-7xl mx-auto px-8 md:px-24 py-20">
    
    <h2 id="titolo-contatti" class="font-title text-center md:text-right w-full text-4xl md:text-6xl mb-16 md:mb-24 text-primary">
      Contatti
    </h2>
<div class="flex flex-col justify-center text-center items-center gap-12 md:gap-16 w-full">
  <div class="max-w-2xl space-y-4">
       <h3 class="font-title text-2xl">Parlami del tuo progetto</h3>
       <p class="text-primary/80">Se preferisci un contatto diretto, puoi scrivermi o chiamarmi qui:</p>
  </div>
  <div class="flex flex-col items-center md:grid md:grid-cols-2 gap-12 md:gap-24 w-full">
<div class="flex flex-col gap-3 items-center md:items-start w-full max-w-sm md:max-w-none">
  <div class="flex flex-col items-center md:items-start gap-2 bg-primary/5 p-4 rounded-xl w-full min-h-32">
    <span class="text-xs font-semibold uppercase tracking-widest text-primary/70">Email</span>
    <a
      href={contact.emailHref}
      class="inline-flex items-center justify-center font-bold hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors"
      aria-label="Scrivi a Mirko Passeri via email"
    >
      Scrivimi via email
    </a>
    <span
      id="email-text"
      data-user={contact.emailUser}
      data-domain={contact.emailDomain}
      class="font-mono font-medium text-primary/80 break-all"
    >
      {contact.emailUser}[at]{contact.emailDomain}
    </span>
    <button id="copy-btn" class="text-accent hover:underline text-sm font-bold uppercase tracking-tighter focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded" aria-label="Copia l'indirizzo email" aria-live="polite">Copia email</button>
  </div>
  <div class="flex flex-col items-center md:items-start gap-2 bg-primary/5 p-4 rounded-xl w-full min-h-32">
    <span class="text-xs font-semibold uppercase tracking-widest text-primary/70">Telefono</span>
    <a
      href={contact.phoneHref}
      class="inline-flex items-center justify-center font-bold hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors"
      aria-label={`Chiama Mirko Passeri al numero ${contact.phoneDisplay}`}
    >
      Parliamone al telefono
    </a>
    <span class="font-mono font-medium text-primary/80">{contact.phoneDisplay}</span>
  </div>
  <div class="flex flex-col items-center md:items-start gap-2 bg-primary/5 p-4 rounded-xl w-full min-h-32">
    <span class="text-xs font-semibold uppercase tracking-widest text-primary/70">WhatsApp</span>
    <a
      href={contact.whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center bg-primary text-master px-5 py-3 rounded-md font-bold hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master transition-colors"
      aria-label={`Scrivi a Mirko Passeri su WhatsApp al numero ${contact.phoneDisplay}`}
    >
      Scrivimi su WhatsApp
    </a>
  </div>
</div>
   <div class="w-full">
        <form action="https://api.web3forms.com/submit" method="POST" class="flex flex-col gap-4">
        <input type="hidden" name="access_key" value={KEY}>
            <label for="name">Nome</label>
            <input required type="text" id="name" name="name" class="ring-1 ring-gray-500 border border-gray-500 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:border-accent">
            <label for="email">Email</label>
            <input required type="email" id="email" name="email" aria-describedby="email-error" class="ring-1 ring-gray-500 border border-gray-500 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:border-accent">
            <span id="email-error" class="sr-only">Inserisci un indirizzo email valido (es. nome@dominio.com)</span>
            <label for="message">Messaggio</label>
            <textarea required id="message" name="message" class="ring-1 ring-gray-500 border border-gray-500 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:border-accent"></textarea>
            
            <div class="flex items-start gap-3 mt-2 mb-2">
                <input required type="checkbox" id="privacy-consent" name="privacy-consent" class="mt-1 w-4 h-4 text-accent bg-transparent border-gray-500 rounded focus:ring-accent focus:ring-2 focus:ring-offset-2 focus:ring-offset-master focus:outline-none cursor-pointer">
                <label for="privacy-consent" class="text-sm text-primary/80 cursor-pointer">
                    Dichiaro di aver letto e accettato la <a href="/privacy-policy/" class="text-accent font-semibold hover:underline focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded" target="_blank" rel="noopener noreferrer">Privacy Policy</a> per il trattamento dei dati personali.*
                </label>
            </div>

            <button type="submit" class="border border-gray-500 rounded-md p-2 bg-primary text-master transition-colors hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master md:w-fit md:self-end">Invia</button>
        </form>
    </div>
  </div>
</div>
</section>  
<script>
  // 1. Cerchiamo gli elementi nel DOM UNA SOLA VOLTA
  const copyBtn = document.getElementById('copy-btn');
  const emailText = document.getElementById('email-text');

  // 2. Protezione Anti-Spam: Costruiamo l'email dinamicamente
  if (emailText) {
    const user = emailText.getAttribute('data-user');
    const domain = emailText.getAttribute('data-domain');
    const email = `${user}@${domain}`;
    emailText.innerText = email;
  }

  // 3. Funzione di Copia
  copyBtn?.addEventListener('click', () => {
    if (emailText) {
      navigator.clipboard.writeText(emailText.innerText);
      
      const originalText = copyBtn.innerText;
      copyBtn.innerText = 'Copiato!';
      
      setTimeout(() => {
        copyBtn.innerText = originalText;
      }, 2000);
    }
  });
</script>
