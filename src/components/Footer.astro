---
import { Icon } from "astro-icon/components";
---

<footer class="w-full border-t border-primary/20 pt-12 pb-8 bg-master">

  <nav aria-label="Navigazione del sito" class="max-w-7xl mx-auto px-8 md:px-24 mb-10">
    <ul class="flex flex-wrap justify-center gap-6 md:gap-10">
      <li>
        <a href="/progetti/" class="text-sm font-semibold uppercase tracking-widest text-primary/70 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300">
          Portfolio
        </a>
      </li>
      <li>
        <a href="/chi-sono/" class="text-sm font-semibold uppercase tracking-widest text-primary/70 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300">
          Chi Sono
        </a>
      </li>
      <li>
        <a href="/realizzazione-siti-web/" class="text-sm font-semibold uppercase tracking-widest text-primary/70 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300">
          Siti web
        </a>
      </li>
      <li>
        <a href="/collaborazioni/" class="text-sm font-semibold uppercase tracking-widest text-primary/70 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300">
          Collaborazioni
        </a>
      </li>
      <li>
        <a href="/blog/" class="text-sm font-semibold uppercase tracking-widest text-primary/70 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300">
          Blog
        </a>
      </li>
      <li>
        <a href="/contatti/" class="text-sm font-semibold uppercase tracking-widest text-primary/70 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300">
          Contatti
        </a>
      </li>
    </ul>
  </nav>

  <nav aria-label="Profili professionali" class="max-w-7xl mx-auto px-8 md:px-24 mb-10">
    <ul class="flex flex-wrap justify-center gap-5 md:gap-8">
      <li>
        <a
          href="https://www.linkedin.com/in/mirko-passeri/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-primary/70 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300"
        >
          <Icon name="linkedin" aria-hidden="true" class="w-5 h-5" />
          LinkedIn
        </a>
      </li>
      <li>
        <a
          href="https://github.com/mirkomkr"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-primary/70 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300"
        >
          <Icon name="github" aria-hidden="true" class="w-5 h-5" />
          GitHub
        </a>
      </li>
      <li>
        <a
          href="https://www.figma.com/proto/YOmJbScwFqpC5ns8DMpfmV/Little-Lemon-Coursera-Assignment---UX-UI-Portfolio-%E2%80%93-Meta-Certificate?page-id=14%3A2&node-id=14-3&p=f&viewport=383%2C396%2C0.6&t=hdItkZxxZeCD5Vop-1&scaling=min-zoom&content-scaling=fixed"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-primary/70 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300"
        >
          <Icon name="figma" aria-hidden="true" class="w-5 h-5" />
          Figma
        </a>
      </li>
    </ul>
  </nav>

  <nav aria-label="Navigazione legale e policy" class="max-w-7xl mx-auto px-8 md:px-24 mb-10">
    <ul class="flex flex-wrap justify-center gap-4 md:gap-8">
      <li>
        <a href="/privacy-policy/" class="text-xs font-semibold tracking-widest text-primary/80 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300">
          Privacy Policy
        </a>
      </li>
      <li>
        <a href="/cookie-policy/" class="text-xs font-semibold tracking-widest text-primary/80 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300">
          Cookie Policy
        </a>
      </li>
    </ul>
  </nav>

  <div class="flex flex-col items-center justify-center gap-4 text-sm text-primary/75">
    <div class="flex items-center gap-2">
      <p>Sviluppato con passione utilizzando</p>
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Coded with Astro"
        class="hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded transition-colors duration-300"
      >
        <Icon name="astro" aria-hidden="true" class="w-6 h-6" />
      </a>
    </div>
    <p class="text-xs text-primary/80 text-center">
      &copy; {new Date().getFullYear()} Mirko Passeri. Tutti i diritti riservati.<!-- <br/>P.IVA: (Aggiungi qui P.IVA se necessario) -->
    </p>
  </div>
</footer>
