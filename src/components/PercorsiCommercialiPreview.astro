---
const percorsi = [
  {
    title: 'Per attività, professionisti e PMI',
    text: 'Progetto siti web ed e-commerce e intervengo su quelli esistenti per presentare servizi e prodotti con chiarezza e rendere più semplice contattarti, chiedere informazioni o acquistare.',
    link: '/realizzazione-siti-web/',
    linkText: 'Scopri siti web ed e-commerce',
  },
  {
    title: 'Per agenzie, designer e piccoli team',
    text: 'Offro supporto frontend per trasformare layout e prototipi in pagine responsive, accessibili e curate, oppure per sviluppare singole sezioni e parti di un progetto già avviato.',
    link: '/collaborazioni/',
    linkText: 'Scopri il supporto frontend',
  },
];
---

<section
  id="servizi"
  aria-labelledby="titolo-percorsi-commerciali"
  class="w-full max-w-7xl mx-auto px-8 md:px-24 py-16 md:py-20 border-t border-primary/10"
>
  <h2
    id="titolo-percorsi-commerciali"
    class="font-title text-left text-4xl md:text-5xl text-primary mb-10 md:mb-12"
  >
    Come posso aiutarti
  </h2>

  <ul class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {
      percorsi.map((percorso) => (
        <li class="flex flex-col items-start rounded-2xl border border-primary/20 p-6 sm:p-8 transition-all duration-300 hover:border-accent/60 hover:bg-primary/[0.03]">
          <h3 class="font-title text-2xl sm:text-3xl text-primary mb-4">{percorso.title}</h3>
          <p class="text-primary/75 leading-relaxed mb-8">{percorso.text}</p>
          <a
            href={percorso.link}
            class="mt-auto inline-flex min-h-12 items-center justify-center gap-2 rounded-md border border-accent/40 px-5 py-3 text-center text-sm font-semibold normal-case tracking-normal text-accent transition-all hover:bg-accent hover:text-master focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
          >
            <span>{percorso.linkText}</span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
