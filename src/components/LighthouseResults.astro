---
import { Image } from "astro:assets";
import LhPortfolio from "../assets/test-lighthouse/portfolio-mirko-passeri-lighthouse-test.webp";
import LhDtf from "../assets/test-lighthouse/ecommerce-dtf-italia-lighthouse-test.webp";

const results = [
  {
    id: "lh-portfolio",
    site: "Portfolio Mirko Passeri",
    url: "mirkopasseri.it",
    image: LhPortfolio,
    alt: "Risultato Lighthouse del portfolio Mirko Passeri con punteggio 100 in Performance, Accessibilità, Best Practices e SEO.",
  },
  {
    id: "lh-dtf",
    site: "DTF Italia — E-commerce",
    url: "dtfitalia.it",
    image: LhDtf,
    alt: "Risultato Lighthouse del progetto DTF Italia con punteggio 100 in Performance, Accessibilità, Best Practices e SEO.",
  },
];

const metrics = [
  { label: "Performance", value: 100 },
  { label: "Accessibilità", value: 100 },
  { label: "Best Practices", value: 100 },
  { label: "SEO", value: 100 },
];
---

<section
  id="risultati"
  aria-labelledby="titolo-risultati"
  class="w-full mt-20 md:mt-24 pt-16 md:pt-20 border-t border-primary/10"
>
  <h2
    id="titolo-risultati"
    class="font-title text-4xl md:text-5xl text-primary mb-4"
  >
    Risultati tecnici
  </h2>
  <div class="text-primary/70 text-lg mb-16 max-w-3xl space-y-4">
    <p>
      Alcuni progetti vengono verificati anche con strumenti come Lighthouse, per controllare
      performance, accessibilità, SEO e buone pratiche tecniche.
    </p>
    <p>
      I punteggi non raccontano tutto, ma aiutano a leggere se una pagina è leggera, navigabile e
      costruita con basi solide.
    </p>
  </div>

  <ul
    class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12"
    role="list"
    aria-label="Risultati degli audit Lighthouse per progetto"
  >
    {
      results.map((r) => (
        <li>
          <button
            type="button"
            class="group w-full text-left rounded-2xl overflow-hidden hover:border-accent/70 border border-primary/30 transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-master"
            aria-labelledby={`azione-${r.id}`}
            aria-describedby={`metriche-${r.id}`}
            aria-haspopup="dialog"
            aria-controls={`dialog-${r.id}`}
            aria-expanded="false"
            data-lightbox-trigger={r.id}
          >
            <figure class="m-0">
              <div class="relative overflow-hidden aspect-video bg-primary/5">
                <Image
                  src={r.image}
                  alt={r.alt}
                  class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 800px"
                />
                <div
                  class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/40"
                  aria-hidden="true"
                >
                  <span class="inline-flex items-center gap-2 bg-master text-primary font-semibold text-sm px-4 py-2 rounded-full shadow-lg">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                    </svg>
                    Ingrandisci
                  </span>
                </div>
              </div>
              <figcaption class="p-5">
                <span id={`azione-${r.id}`} class="sr-only">
                  Ingrandisci il risultato Lighthouse per {r.site}
                </span>
                <p class="font-bold text-primary text-base group-hover:text-accent transition-colors duration-300">
                  {r.site}
                </p>
                <p class="text-xs text-primary/50 mt-0.5">{r.url}</p>
                <dl
                  id={`metriche-${r.id}`}
                  class="grid grid-cols-2 gap-x-5 gap-y-2 mt-5 pt-4 border-t border-primary/10 text-sm"
                >
                  {metrics.map((metric) => (
                    <div class="flex items-baseline justify-between gap-3">
                      <dt class="text-primary/65">{metric.label}</dt>
                      <dd class="font-semibold text-primary">{metric.value}</dd>
                    </div>
                  ))}
                </dl>
              </figcaption>
            </figure>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<!-- Lightbox dialog — ARIA dialog pattern WCAG 2.1 AA -->
{
  results.map((r) => (
    <div
      id={`dialog-${r.id}`}
      role="dialog"
      aria-modal="true"
      aria-label={`Anteprima test Lighthouse: ${r.site}`}
      aria-hidden="true"
      hidden
      inert
      class="lh-dialog fixed inset-0 z-50 flex items-center justify-center p-4 md:p-8 bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
      data-lightbox-id={r.id}
    >
      <div class="relative w-full max-w-4xl rounded-2xl overflow-hidden shadow-2xl bg-master">
        <button
          type="button"
          class="lh-dialog-close absolute top-4 right-4 z-10 flex items-center justify-center w-10 h-10 rounded-full bg-master/80 backdrop-blur-sm border border-primary/20 text-primary hover:text-accent hover:border-accent/40 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-master"
          aria-label="Chiudi anteprima"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
        <figure class="m-0">
          <Image
            src={r.image}
            alt={r.alt}
            class="w-full h-auto object-contain"
            loading="lazy"
            decoding="async"
            widths={[400, 800, 1200]}
            sizes="(max-width: 1024px) 100vw, 1200px"
          />
          <figcaption class="px-6 py-4">
            <div>
              <p class="font-bold text-primary text-base">{r.site}</p>
              <p class="text-xs text-primary/50 mt-0.5">{r.url}</p>
            </div>
            <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4 pt-4 border-t border-primary/10">
              {metrics.map((metric) => (
                <div>
                  <dt class="text-xs text-primary/60">{metric.label}</dt>
                  <dd class="font-semibold text-primary">{metric.value}</dd>
                </div>
              ))}
            </dl>
          </figcaption>
        </figure>
      </div>
    </div>
  ))
}

<script>
  // ── Lightbox — ARIA dialog pattern WCAG 2.1 AA ────────────────────────────
  // Gestione: open/close, focus trap, Escape key, click backdrop

  const FOCUSABLE =
    'a[href], button:not([disabled]), input, textarea, select, [tabindex]:not([tabindex="-1"])';
  const MANAGED_FOCUSABLE = 'a[href], button, input, textarea, select, [tabindex]';

  function getFocusable(el: HTMLElement): HTMLElement[] {
    return Array.from(el.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
      (e) => !e.closest("[hidden]")
    );
  }

  function disableDialogFocus(dialog: HTMLElement) {
    dialog.querySelectorAll<HTMLElement>(MANAGED_FOCUSABLE).forEach((el) => {
      if (!el.hasAttribute("data-original-tabindex")) {
        el.dataset.originalTabindex = el.getAttribute("tabindex") ?? "";
      }

      el.setAttribute("tabindex", "-1");
    });
  }

  function restoreDialogFocus(dialog: HTMLElement) {
    dialog.querySelectorAll<HTMLElement>("[data-original-tabindex]").forEach((el) => {
      const originalTabindex = el.dataset.originalTabindex;

      if (originalTabindex) {
        el.setAttribute("tabindex", originalTabindex);
      } else {
        el.removeAttribute("tabindex");
      }

      delete el.dataset.originalTabindex;
    });
  }

  function openDialog(id: string) {
    const dialog = document.querySelector<HTMLElement>(
      `[data-lightbox-id="${id}"]`
    );
    if (!dialog) return;

    const trigger = document.querySelector<HTMLElement>(
      `[data-lightbox-trigger="${id}"]`
    );

    dialog.hidden = false;
    dialog.removeAttribute("aria-hidden");
    dialog.removeAttribute("inert");
    restoreDialogFocus(dialog);
    trigger?.setAttribute("aria-expanded", "true");

    requestAnimationFrame(() => {
      dialog.classList.remove("opacity-0", "pointer-events-none");
      dialog.classList.add("opacity-100");
    });

    // Focus trap: prima element focusable nel dialog
    const focusable = getFocusable(dialog);
    focusable[0]?.focus();

    // Blocca scroll body
    document.body.style.overflow = "hidden";

    // Trap focus dentro il dialog
    dialog.addEventListener("keydown", trapFocus);
  }

  function closeDialog(dialog: HTMLElement) {
    // Restituisce il focus al trigger che ha aperto il dialog
    const id = dialog.dataset.lightboxId;
    const trigger = document.querySelector<HTMLElement>(
      `[data-lightbox-trigger="${id}"]`
    );
    trigger?.focus();
    trigger?.setAttribute("aria-expanded", "false");

    dialog.setAttribute("aria-hidden", "true");
    dialog.setAttribute("inert", "");
    disableDialogFocus(dialog);
    dialog.classList.add("opacity-0", "pointer-events-none");
    dialog.classList.remove("opacity-100");
    document.body.style.overflow = "";
    dialog.removeEventListener("keydown", trapFocus);

    window.setTimeout(() => {
      if (dialog.getAttribute("aria-hidden") === "true") {
        dialog.hidden = true;
      }
    }, 300);
  }

  function trapFocus(e: KeyboardEvent) {
    const dialog = (e.currentTarget as HTMLElement);
    const focusable = getFocusable(dialog);
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.key === "Escape") {
      closeDialog(dialog);
      return;
    }

    if (e.key === "Tab") {
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last?.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first?.focus();
        }
      }
    }
  }

  // Trigger buttons → apri il dialog corrispondente
  document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.lightboxTrigger!;
      openDialog(id);
    });
  });

  // Pulsanti di chiusura
  document.querySelectorAll<HTMLElement>(".lh-dialog-close").forEach((btn) => {
    btn.addEventListener("click", () => {
      const dialog = btn.closest<HTMLElement>(".lh-dialog");
      if (dialog) closeDialog(dialog);
    });
  });

  // Click fuori dal contenuto del dialog → chiude
  document.querySelectorAll<HTMLElement>(".lh-dialog").forEach((dialog) => {
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeDialog(dialog);
    });
  });
</script>
