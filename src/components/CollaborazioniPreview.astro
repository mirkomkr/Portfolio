---
const benefits = [
  'sviluppo frontend da layout grafici',
  'accessibilità e semantica HTML',
  'performance e qualità del codice',
  'landing page, componenti, refactor e sezioni e-commerce',
];
---

<section
  id="collaborazioni"
  aria-labelledby="titolo-collaborazioni"
  class="flex flex-col justify-center items-center md:items-end w-full min-h-screen max-w-7xl mx-auto px-8 md:px-24 py-20"
>
  <div class="flex items-center justify-center md:justify-end gap-4 w-full mb-16 md:mb-24">
    <h2
      id="titolo-collaborazioni"
      class="font-title text-center md:text-right text-4xl md:text-6xl text-primary"
    >
      Collaborazioni
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 w-full items-start">
    <div class="space-y-6 text-lg text-primary/80 leading-relaxed">
      <p>
        Offro supporto ad agenzie, freelance, designer e realtà creative nello sviluppo di
        interfacce responsive, accessibili e performanti, anche su singole parti di progetto.
      </p>
      <ul class="grid gap-3 text-base text-primary/75" aria-label="Aree di supporto frontend">
        {
          benefits.map((benefit) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent" />
              <span>{benefit}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:text-right">
      <a
        href="/collaborazioni/"
        class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-accent border border-accent/40 px-6 py-3 rounded-md hover:bg-accent hover:text-master transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
        aria-label="Vai alla pagina sul supporto frontend per collaborazioni"
      >
        <span>Supporto frontend</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
