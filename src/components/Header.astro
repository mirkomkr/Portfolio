---
import { mainNavigationLinks } from '../data/navigation.js';

const normalizePath = (path) => (path.endsWith('/') ? path : `${path}/`);
const currentPath = normalizePath(Astro.url.pathname);
---

<header class="border-b border-primary/10 bg-master">
  <nav
    aria-label="Navigazione principale"
    class="max-w-7xl mx-auto px-8 py-5 md:px-24"
  >
    <div class="flex flex-wrap items-center justify-between gap-4 lg:flex-nowrap lg:gap-10">
      <a
        href="/"
        class="font-title text-xl text-primary transition-colors hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
        aria-label="Vai alla homepage di Mirko Passeri"
      >
        Mirko Passeri
      </a>
      <button
        id="site-menu-toggle"
        type="button"
        class="inline-flex min-h-11 items-center justify-center rounded-md border border-primary/20 px-4 py-2 text-sm font-semibold text-primary transition-colors hover:border-accent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master lg:hidden"
        aria-controls="site-navigation"
        aria-expanded="false"
        aria-label="Apri menu di navigazione"
      >
        <span data-menu-label>Menu</span>
      </button>
      <ul
        id="site-navigation"
        class="hidden w-full flex-col gap-4 border-t border-primary/10 pt-5 lg:flex lg:w-auto lg:flex-row lg:flex-wrap lg:items-center lg:justify-end lg:gap-x-5 lg:gap-y-3 lg:border-0 lg:pt-0"
      >
        {mainNavigationLinks.map((link) => {
          const isCurrentPage = currentPath === link.href;

          return (
            <li>
              <a
                href={link.href}
                aria-current={isCurrentPage ? 'page' : undefined}
                class="inline-flex min-h-10 items-center text-sm font-semibold text-primary/75 transition-colors hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded aria-[current=page]:text-primary"
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</header>

<script is:inline>
  const menuButton = document.getElementById('site-menu-toggle');
  const menu = document.getElementById('site-navigation');
  const menuLabel = menuButton?.querySelector('[data-menu-label]');

  if (menuButton && menu && menuLabel) {
    const setMenuOpen = (isOpen) => {
      menuButton.setAttribute('aria-expanded', String(isOpen));
      menuButton.setAttribute(
        'aria-label',
        isOpen ? 'Chiudi menu di navigazione' : 'Apri menu di navigazione'
      );
      menuLabel.textContent = isOpen ? 'Chiudi' : 'Menu';
      menu.classList.toggle('hidden', !isOpen);
      menu.classList.toggle('flex', isOpen);
    };

    menuButton.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isOpen);
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        menuButton.focus();
      }
    });
  }
</script>
