---
import { projects } from "./projectArray.js";
import Card from "./Card.astro";
---

<section id="progetti" aria-labelledby="lista-progetti" class="mt-20 md:mt-24">
  <h2 id="lista-progetti" class="font-title text-4xl md:text-5xl text-primary mb-10">
    Progetti selezionati
  </h2>

  <ul class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-10 lg:grid-cols-3">
    {projects.map((project) => (
      <Card {...project} />
    ))}
  </ul>
</section>
