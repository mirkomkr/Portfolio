---
// import { Image } from 'astro:assets';
// import HeroPortrait from '../assets/images/profile/mirko-passeri-hero.webp';
---

<section
  aria-labelledby="titolo-hero"
  class="hero-section bg-master text-primary flex items-start w-full max-w-7xl mx-auto px-8 md:px-24 py-14 md:py-16"
>
  <div class="w-full">
    <div class="text-center md:max-w-3xl md:text-left">
      <!-- Foto temporaneamente sospesa in attesa dell'asset definitivo.
      <div class="mb-6 flex justify-center md:justify-start lg:hidden">
        <Image
          src={HeroPortrait}
          alt="Ritratto di Mirko Passeri, frontend developer e web designer."
          widths={[320, 384, 480, 640]}
          sizes="(min-width: 640px) 24rem, calc(100vw - 4rem)"
          class="hero-intro-image aspect-[16/10] w-full max-w-xs rounded-2xl border border-primary/20 object-cover object-[center_38%] shadow-sm sm:max-w-sm"
          loading="eager"
          decoding="async"
        />
      </div>
      -->

      <p class="text-base md:text-lg font-medium normal-case tracking-normal text-accent">Ciao, sono Mirko Passeri</p>

      <h1
        id="titolo-hero"
        class="mt-4 font-title text-6xl sm:text-7xl md:text-8xl font-bold leading-tight text-balance"
      >
        Siti web chiari, veloci e accessibili
      </h1>

      <p
        class="mt-6 max-w-3xl text-xl sm:text-2xl md:text-3xl text-primary/90 leading-snug text-pretty"
      >
        Realizzo siti web ed e-commerce per attività e professionisti. Intervengo anche su siti
        esistenti per migliorarne struttura, contenuti ed esperienza d’uso.
      </p>

      <p class="mt-6 max-w-3xl text-lg md:text-xl text-primary/80 leading-relaxed text-pretty">
        Lavoro con clienti ad Anzio e Nettuno e seguo progetti da remoto in tutta Italia. Collaboro
        anche con agenzie, designer e piccoli team come supporto frontend.
      </p>

      <div
        class="mt-10 flex flex-col items-stretch justify-center gap-4 sm:flex-row md:justify-start"
      >
        <a
          href="/realizzazione-siti-web/"
          class="inline-flex min-h-12 items-center justify-center rounded-md border border-accent bg-accent px-6 py-3 text-center text-sm font-semibold normal-case tracking-normal text-master transition-all hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
        >
          Scopri i servizi per il tuo sito
        </a>
        <a
          href="/progetti/"
          class="inline-flex min-h-12 items-center justify-center rounded-md border border-accent/40 px-6 py-3 text-center text-sm font-semibold normal-case tracking-normal text-accent transition-all hover:bg-accent hover:text-master focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
        >
          Guarda i progetti
        </a>
      </div>
    </div>

    <!-- Foto temporaneamente sospesa in attesa dell'asset definitivo.
    <div class="hidden justify-center lg:flex lg:justify-end">
      <div
        class="flex aspect-[3/4] w-full max-w-44 items-center justify-center overflow-hidden rounded-lg border border-primary/20 bg-primary/[0.03] shadow-sm sm:max-w-56 lg:max-w-80 lg:shadow-md"
      >
        <Image
          src={HeroPortrait}
          alt="Ritratto di Mirko Passeri, frontend developer e web designer."
          widths={[240, 320, 448, 640]}
          sizes="20rem"
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
    -->
  </div>
</section>

<style>
  /*
  @media (min-width: 640px) and (max-height: 1100px) {
    .hero-intro-image {
      max-width: 20rem;
    }
  }
  */

  @media (min-width: 1280px) and (min-height: 900px) {
    .hero-section {
      align-items: center;
      min-height: 82svh;
      padding-block: 6rem;
    }
  }
</style>
