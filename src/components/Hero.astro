---
import { Icon } from 'astro-icon/components';
---

<section
  aria-label="Introduzione"
  class="bg-master text-primary flex flex-col text-center justify-center items-center md:items-end md:text-right gap-4 w-full min-h-screen max-w-7xl mx-auto px-8 md:px-24"
>
  <h1 class="text-6xl md:text-8xl font-bold mb-2 font-title leading-tight">Mirko Passeri</h1>

  <h2 class="text-2xl md:text-3xl font-medium mb-8 text-accent/90 tracking-tight">
    Frontend Developer &amp; Web Designer
  </h2>

  <nav aria-label="Navigazione principale">
    <ul
      class="grid grid-cols-2 sm:grid-cols-4 justify-items-center items-center md:justify-end gap-6 md:gap-8 w-full max-w-lg md:max-w-2xl mx-auto md:mx-0 md:ml-auto mb-10"
    >
      <li>
        <a
          href="#chi-sono"
          aria-label="Scopri chi sono"
          class="flex flex-col items-center gap-2 group transition-all focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
        >
          <Icon
            name="persona"
            aria-hidden="true"
            class="w-8 h-8 md:w-10 md:h-10 group-hover:text-accent transition-colors"
          />
          <span class="text-xs md:text-sm font-semibold uppercase tracking-widest">Chi Sono</span>
        </a>
      </li>
      <li>
        <a
          href="#progetti"
          aria-label="Esplora i miei progetti"
          class="flex flex-col items-center gap-2 group transition-all focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
        >
          <Icon
            name="progetti"
            aria-hidden="true"
            class="w-8 h-8 md:w-10 md:h-10 group-hover:text-accent transition-colors"
          />
          <span class="text-xs md:text-sm font-semibold uppercase tracking-widest">Progetti</span>
        </a>
      </li>
      <li>
        <a
          href="#collaborazioni"
          aria-label="Scopri le collaborazioni frontend"
          class="flex flex-col items-center gap-2 group transition-all focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
        >
          <Icon
            name="collaborazioni"
            aria-hidden="true"
            class="w-8 h-8 md:w-10 md:h-10 group-hover:text-accent transition-colors"
          />
          <span class="text-xs md:text-sm font-semibold uppercase tracking-widest">Collaborazioni</span>
        </a>
      </li>
      <li>
        <a
          href="#contatti"
          aria-label="Vai ai contatti"
          class="flex flex-col items-center gap-2 group transition-all focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master focus:rounded"
        >
          <Icon
            name="messaggio"
            aria-hidden="true"
            class="w-8 h-8 md:w-10 md:h-10 group-hover:text-accent transition-colors"
          />
          <span class="text-xs md:text-sm font-semibold uppercase tracking-widest">Contatti</span>
        </a>
      </li>
    </ul>
  </nav>

  <p class="font-medium italic pr-4 md:border-r-4 md:border-accent text-lg md:text-xl text-primary">
    Sviluppo soluzioni web su misura — veloci, accessibili, senza scorciatoie.
  </p>

  <div class="mt-8">
    <a
      href="#contatti"
      aria-label="Contattami"
      class="inline-flex items-center gap-3 px-8 py-4 rounded-md bg-accent text-master border border-accent font-bold transition-all hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
    >
      <Icon name="messaggio" aria-hidden="true" class="size-5" />
      Contattami
    </a>
  </div>
</section>
