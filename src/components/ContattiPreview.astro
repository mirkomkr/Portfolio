---
import { contact } from '../data/contact.js';
---

<section
  aria-labelledby="titolo-contatti-preview"
  class="w-full max-w-7xl mx-auto px-8 md:px-24 py-16 md:py-20"
>
  <div class="max-w-3xl">
    <h2 id="titolo-contatti-preview" class="font-title text-4xl md:text-5xl text-primary">
      Parliamo del tuo progetto
    </h2>
    <p class="mt-6 text-lg md:text-xl text-primary/80 leading-relaxed">
      Se devi creare un nuovo sito, migliorare quello che hai già o hai bisogno di supporto frontend
      per un progetto, scrivimi: partiamo da obiettivi, priorità e prossimi passi.
    </p>
    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
      <a
        href="/contatti/"
        class="inline-flex min-h-12 items-center justify-center rounded-md border border-accent bg-accent px-6 py-3 text-center text-sm font-semibold normal-case tracking-normal text-master transition-all hover:bg-transparent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
      >
        Parlami del tuo progetto
      </a>
      <a
        href={contact.emailHref}
        class="inline-flex min-h-12 items-center justify-center rounded-md border border-accent/40 px-6 py-3 text-center text-sm font-semibold normal-case tracking-normal text-accent transition-all hover:bg-accent hover:text-master focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-master"
        aria-label="Scrivi a Mirko Passeri via email"
      >
        Scrivimi via email
      </a>
    </div>
  </div>
</section>
