---
import { Image } from 'astro:assets';
const {title, description, image, altimage, link, lighthouseScore} = Astro.props;
---

<li itemscope itemtype="https://schema.org/CreativeWork" class="focus-within:ring-2 focus-within:ring-accent relative group rounded-2xl flex flex-col transition-all duration-500 overflow-hidden hover:bg-primary/[0.03] hover:-translate-y-1">
    
    <div class="relative">
      <Image
        itemprop="image"
        src={image}
        class="transition-transform duration-700 group-hover:scale-105 aspect-video object-cover w-full"
        alt={altimage}
      />
      {lighthouseScore && (
        <span
          class="absolute top-3 right-3 inline-flex items-center gap-1.5 bg-master/90 backdrop-blur-sm text-accent border border-accent/30 text-xs font-bold px-2.5 py-1 rounded-full shadow-md"
          aria-label={`Punteggio Lighthouse ${lighthouseScore} su 100`}
        >
          Lighthouse score:
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
          {lighthouseScore} / 100
        </span>
      )}
    </div>
    
    <div class="text-primary p-6">
      <h3 itemprop="name" class="group-hover:text-accent transition-colors duration-300 text-2xl font-bold mb-2 font-title">
        {title}
      </h3>
      <p itemprop="description" id={`desc-${title.split(" ").join("-").toLowerCase()}`} class="leading-relaxed text-sm opacity-70">
        {description}
      </p>
    </div>

    <a aria-describedby={`desc-${title.split(" ").join("-").toLowerCase()}`} itemprop="url" href={link} 
       class="after:content-[''] after:absolute after:inset-0 focus:rounded-2xl" 
       target="_blank" 
       rel="noopener noreferrer" 
       aria-label={`Scopri di più su ${title}`}>
    </a>
</li>
