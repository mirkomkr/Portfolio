---
import { Image } from 'astro:assets';
const { title, description, image, altimage, link, classificationLabel, caseStudyLink } = Astro.props;
const descriptionId = `desc-${title.split(" ").join("-").toLowerCase()}`;
---

<li itemscope itemtype="https://schema.org/CreativeWork" class="hover:border-accent/70 border border-primary/30 relative group rounded-2xl flex flex-col transition-all duration-500 overflow-hidden hover:bg-primary/[0.03] hover:-translate-y-1">
    
    <div class="relative">
      <Image
        itemprop="image"
        src={image}
        class="transition-transform duration-700 group-hover:scale-105 aspect-video object-cover w-full"
        alt={altimage}
        widths={[400, 800, 1200]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
      />

<!--       {lighthouseScore && (
        <span
          class="absolute top-3 right-3 inline-flex items-center gap-1.5 bg-master/90 backdrop-blur-sm text-accent border border-accent/30 text-xs font-bold px-2.5 py-1 rounded-full shadow-md"
          aria-label={`Punteggio Lighthouse ${lighthouseScore} su 100`}
        >
          Lighthouse score:
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
          {lighthouseScore} / 100
        </span>
      )} -->

    </div>
    
    <div class="text-primary p-6 flex flex-1 flex-col">
      <h3 itemprop="name" class="group-hover:text-accent transition-colors duration-300 text-2xl font-bold mb-2 font-title">
        {title}
      </h3>
      <p class="mb-4">
        <span class="inline-flex rounded-full border border-primary/20 px-3 py-1 text-xs font-semibold text-primary/75">
          {classificationLabel}
        </span>
      </p>
      <p itemprop="description" id={descriptionId} class="leading-relaxed text-sm opacity-70">
        {description}
      </p>

      <div class="mt-auto flex flex-col gap-3 pt-6 sm:flex-row sm:flex-wrap">
        {caseStudyLink ? (
          <>
            <a
              href={caseStudyLink}
              aria-describedby={descriptionId}
              class="inline-flex min-h-12 w-full items-center justify-center rounded-md border border-accent bg-accent px-4 py-3 text-center text-sm font-semibold text-master transition-colors hover:bg-transparent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-master sm:w-auto"
            >
              Leggi il caso studio
            </a>
            <a
              itemprop="url"
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              aria-describedby={descriptionId}
              class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-md border border-primary/30 px-4 py-3 text-center text-sm font-semibold text-primary transition-colors hover:border-accent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-master sm:w-auto"
            >
              Apri la demo
              <span aria-hidden="true">↗</span>
            </a>
          </>
        ) : (
          <a
            itemprop="url"
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            aria-describedby={descriptionId}
            class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-md border border-accent bg-accent px-4 py-3 text-center text-sm font-semibold text-master transition-colors hover:bg-transparent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-master sm:w-auto"
          >
            Apri il progetto
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
</li>
